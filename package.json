{
  "name": "inkstone",
  "version": "0.1.0",
  "private": true,
  "description": "砚台 — 本地优先的中文小说创作工作台",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @inkstone/desktop build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @inkstone/shared typecheck && pnpm --filter @inkstone/md-adapter typecheck && pnpm --filter @inkstone/desktop typecheck",
    "sidecar:setup": "node scripts/setup-sidecar.mjs",
    "sidecar:test": "node scripts/run-sidecar-tests.mjs",
    "sidecar:smoke": "node scripts/sidecar-smoke.mjs",
    "sidecar:lint": "node scripts/run-sidecar-lint.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "sidecar:smoke:packed": "node scripts/sidecar-smoke.mjs --packed",
    "dist:win": "node scripts/dist-win.mjs",
    "shared:test": "pnpm --filter @inkstone/shared test",
    "md-adapter:test": "pnpm --filter @inkstone/md-adapter test",
    "verify": "pnpm lint && pnpm format:check && pnpm sidecar:lint && pnpm typecheck && pnpm sidecar:test && pnpm shared:test && pnpm md-adapter:test && pnpm --filter @inkstone/desktop test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
